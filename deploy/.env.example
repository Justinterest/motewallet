# =============================================================================
# Motewallet Withdrawal — 生产环境变量
# 复制为 deploy/.env 后填写真实值（不要提交 .env）
# =============================================================================

# ---- 镜像标签（deploy 脚本会自动更新）----
BACKEND_TAG=latest
FRONTEND_TAG=latest
ADMIN_TAG=latest

# ---- 端口绑定（全部仅本机；API 不对外，由 nginx 同域转发 /api/）----
BACKEND_HOST_BIND=127.0.0.1
BACKEND_PORT=8080
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_PORT=3000
ADMIN_HOST_BIND=127.0.0.1
ADMIN_PORT=3001

# ---- 应用 ----
APP_ENV=production
APP_PORT=8080

# ---- 数据库（请改为生产 RDS / MySQL）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=motewallet
DB_PASSWORD=change-me
DB_NAME=motewallet

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# ---- 前端域名（CORS / Cookie）----
FRONTEND_URL=https://wallet.motewallet.com
ADMIN_URL=https://portal.motewallet.com

# ---- KUN Payment ----
KUN_APP_KEY=
KUN_API_VERSION=2
KUN_PRIVATE_KEY=
KUN_PUBLIC_KEY=
KUN_API_BASE_URL=https://api.kun.global
KUN_REGION_CODE=KUN_PL
KUN_CUSTOMER_NO=
KUN_API_TIMEOUT=30s
KUN_WEBHOOK_TIME_DIFF=5m
KUN_MOCK_ENABLED=false

# ---- S3 ----
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=motewallet
S3_PRESIGN_EXPIRY=15m

# ---- Aliyun DirectMail ----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=Motewallet
ALIYUN_DM_TAG_NAME=
