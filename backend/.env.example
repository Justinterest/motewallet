APP_PORT=8080
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=motewallet
JWT_SECRET=motewallet-jwt-secret-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# KUN Payment API
# Private/public keys: PEM block or raw base64 (KUN dashboard format) both supported.
KUN_APP_KEY=
KUN_API_VERSION=2
KUN_PRIVATE_KEY=
KUN_PUBLIC_KEY=
KUN_API_BASE_URL=https://api.kun.global
KUN_REGION_CODE=KUN_PL
KUN_CUSTOMER_NO=
KUN_API_TIMEOUT=30s
KUN_WEBHOOK_TIME_DIFF=5m
KUN_MOCK_ENABLED=false

# S3 — staging area for KYC files before forwarding to KUN
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=motewallet
S3_PRESIGN_EXPIRY=15m

# Aliyun DirectMail — optional; when unset, verification codes are logged to server console
# AccountName must be a verified sender address in the DirectMail console
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=Motewallet
ALIYUN_DM_TAG_NAME=
